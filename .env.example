# Google AI Studio (Gemini API)
# 取得: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# 使用するモデル (任意、既定: gemini-2.5-flash)
# 高品質を優先するなら gemini-2.5-pro、コスト/速度優先なら gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Postgres 接続文字列
# Vercel ダッシュボード → Storage → Neon Postgres を追加すると DATABASE_URL が自動注入される
# (旧 Vercel Postgres を使う場合は POSTGRES_URL でも読み取り可)
DATABASE_URL=postgresql://user:password@host/dbname

# Vercel Blob (Vercel ダッシュボードで Blob を作成すると自動で注入される)
BLOB_READ_WRITE_TOKEN=

# /api/seed への簡易ガード (任意)
SEED_SECRET=change-me
