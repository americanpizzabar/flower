# Google AI Studio (Gemini API)
# 取得: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# 使用するモデル (任意、既定: gemini-2.5-flash)
# 高品質を優先するなら gemini-2.5-pro、コスト/速度優先なら gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Vercel Postgres (Vercel ダッシュボードで Storage を作成すると自動で注入される)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel Blob (Vercel ダッシュボードで Blob を作成すると自動で注入される)
BLOB_READ_WRITE_TOKEN=

# /api/seed への簡易ガード (任意)
SEED_SECRET=change-me
